# Copy to .env and edit. Never commit .env.

# Port the web UI/API is published on (80 = http://<server-ip>/)
HTTP_PORT=80

# PostgreSQL
POSTGRES_DB=gmsun
POSTGRES_USER=gmsun
POSTGRES_PASSWORD=change-me-strong-db-password

# JWT signing key — at least 32 random characters:  openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-hex-string
ACCESS_TOKEN_MINUTES=720

# First admin account (created on first start only; change the password after login)
ADMIN_EMAIL=admin@gmsun.local
ADMIN_PASSWORD=admin1234

# Allowed browser origins for the API. "*" is fine behind the bundled nginx.
# For the Android app talking to http://192.168.1.50 keep "*" or list the origins.
CORS_ORIGINS=*

# Seed the catalog (panels, Deye inverters/batteries, mounting rules, labor matrix) on first start
SEED_DEMO=true

# pgAdmin (database viewer/editor at http://<server-ip>/pgadmin/). Login with these credentials,
# then open "Servers → gmsun" and enter POSTGRES_PASSWORD once.
PGADMIN_EMAIL=admin@gmsun.local
PGADMIN_PASSWORD=change-me-pgadmin

# Tailscale (optional): pre-authenticated key from https://login.tailscale.com/admin/settings/keys
# If empty, the installer prints the "tailscale up" login link instead.
TS_AUTHKEY=
